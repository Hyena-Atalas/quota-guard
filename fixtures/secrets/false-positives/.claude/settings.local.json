{
  "permissions": {
    "allow": [
      "Bash(PGPASSWORD=${PGPASSWORD} psql)",
      "Bash(PGPASSWORD=changeme psql)",
      "Bash(PGPASSWORD=<PASSWORD> psql)",
      "Bash(sshpass -p 'your-password-here' ssh host)",
      "Bash(curl -H \"Authorization: Bearer $GITHUB_TOKEN\")",
      "Bash(curl -H \"Authorization: Bearer your-api-key-here\")",
      "Bash(export TOKEN=REDACTED)",
      "Bash(mysql -p)"
    ]
  },
  "env": {
    "OPENAI_API_KEY": "${OPENAI_API_KEY}",
    "NOTE": "documentation example only: sk-xxxxxxxxxxxxxxxx"
  }
}
